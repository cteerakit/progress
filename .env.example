# Copy to .env.local and set your Chrome extension OAuth client ID.
WXT_OAUTH_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# Google Picker (drive.file). Use the Cloud project number, not the project ID.
WXT_GOOGLE_API_KEY=YOUR_BROWSER_API_KEY
WXT_GOOGLE_APP_ID=YOUR_CLOUD_PROJECT_NUMBER

# Optional override for local testing of docs/picker.html
# WXT_PICKER_PAGE_URL=http://127.0.0.1:4173/picker.html

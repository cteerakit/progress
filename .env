# Public build IDs for the published extension. Committed on purpose: every
# value here ships inside the extension (manifest.json / bundled JS) anyway.
# Protection comes from restrictions in Google Cloud Console, not secrecy:
#   - OAuth clients only accept this extension's redirect URI
#   - the API key is restricted to the Google Picker API + progress.teerakit.com
# Put machine-specific overrides in .env.local (ignored).

# OAuth client of type "Chrome extension".
WXT_OAUTH_CLIENT_ID=970304313654-1bqbc9j1r68ea63bmch76kat6r2bd566.apps.googleusercontent.com

# OAuth client of type "Web application" (one-pick file consent).
WXT_OAUTH_WEB_CLIENT_ID=970304313654-htakc9b9a8kv876u5lso537i2qsf4o6f.apps.googleusercontent.com

# Google Picker: browser API key and Cloud project NUMBER (not project ID).
WXT_GOOGLE_API_KEY=AIzaSyCq-it4NHxyjn7isWRfH5OyVx05-do_LvM
WXT_GOOGLE_APP_ID=970304313654
